# ================================================
# Z.R.I.C engine example configuration
# Copy this file to .env and fill in your local values.
# Never commit real API keys or private endpoints.
# ================================================

# OpenAI-compatible endpoint for chat, embeddings, and image generation.
OPENAI_COMPAT_PROVIDER_NAME=OpenAI
OPENAI_COMPAT_API_KEY=replace-with-your-api-key
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1

# Default models for each capability. These can also be changed in the UI.
OPENAI_COMPAT_CHAT_MODEL=gpt-4.1-mini
OPENAI_COMPAT_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_COMPAT_IMAGE_MODEL=gpt-image-1
OPENAI_COMPAT_IMAGE_SIZE=1024x1024

# Optional: enable background embedding rebuild when loading bundled RAG data.
# Disabled by default to avoid surprise provider calls during normal play.
ZRIC_AUTO_REBUILD_RAG_EMBEDDINGS=0

# Optional: set this when exposing the server beyond localhost.
# ZRIC_ADMIN_TOKEN=replace-with-a-long-random-token
